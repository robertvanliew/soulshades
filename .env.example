# Copy this file to .env and fill in real values before deploying.
# Do NOT commit .env — it is already covered by .gitignore.

# ── Stripe (music store checkout) ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Resend (transactional email: booking inquiries + download links) ──
RESEND_API_KEY=
FROM_EMAIL="Soul Shades <noreply@soulshadesmusic.com>"
REPLY_TO_EMAIL=bookings@soulshadesmusic.com
# Optional: mailing-list sign-ups (api/subscribe.ts) are saved as Resend
# contacts either way; set this to also add them to one segment (Resend →
# Audience → Segments → copy the ID), e.g. a "Fans" segment for broadcasts.
RESEND_SEGMENT_ID=

# ── Cloudflare R2 (stores the purchasable master files) ────
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── Site config ─────────────────────────────────────────────
SITE_URL=https://soulshadesmusic.com

# ── Optional: admin catalog editing (api/catalog.ts POST) ──
# Not required for the site to function — only needed if you build
# an admin UI to edit track visibility/order via api/catalog.ts.
# Also requires Vercel Blob storage to be provisioned for this project.
ADMIN_SECRET=

# ── Cloudflare Turnstile (invisible bot check on the booking form) ──
# Free: dash.cloudflare.com → Turnstile → Add widget (hostname soulshadesmusic.com,
# mode "Managed"). Leave both empty to run without it (other spam guards still apply).
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics & ad pixels (all optional; public IDs, not secrets) ──
# Nothing loads, and no cookie banner shows, until at least one is set.
# Visitors must accept the cookie notice before any of these load.
VITE_GA_ID=              # Google Analytics 4, e.g. G-XXXXXXXXXX
VITE_GOOGLE_ADS_ID=      # Google Ads, e.g. AW-XXXXXXXXXX
VITE_META_PIXEL_ID=      # Meta (Facebook / Instagram) pixel
VITE_TIKTOK_PIXEL_ID=    # TikTok pixel
